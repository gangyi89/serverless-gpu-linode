NATS_URL=nats://nats:4222

NATS_STREAM=GPU_JOBS
NATS_SUBJECT=GPU_JOBS
NATS_CONSUMER=gpu-workers

NATS_DLQ_SUBJECT=GPU_JOBS.DLQ
NATS_DLQ_STREAM=GPU_JOBS_DLQ

# HEARTBEAT_INTERVAL is agent-local and must be lower than consumer ACK_WAIT.
# this assumes a 20s processing time by ai service
HTTP_TIMEOUT=30s
MAX_INFLIGHT=1
HEARTBEAT_INTERVAL=30s
MAX_DELIVER=3
RETRY_DELAY=10s
DRAIN_TIMEOUT=45s
PROCESS_DURATION=20s

LOG_LEVEL=DEBUG
