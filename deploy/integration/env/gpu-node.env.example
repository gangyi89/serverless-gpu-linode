NATS_AGENT_IMAGE=docker.io/your-user/serverless-gpu-nats-agent:latest
AI_PROCESSOR_IMAGE=docker.io/your-user/serverless-gpu-ai-processor:latest

NATS_URL=nats://<control-plane-ip>:4222
NATS_STREAM=GPU_JOBS
NATS_SUBJECT=GPU_JOBS
NATS_CONSUMER=gpu-workers
NATS_DLQ_SUBJECT=GPU_JOBS.DLQ
NATS_DLQ_STREAM=GPU_JOBS_DLQ

# Durable consumer settings (ACK_WAIT/MAX_DELIVER) are owned by control-plane orchestrator.
# HEARTBEAT_INTERVAL is agent-local and must be lower than consumer ACK_WAIT.
HTTP_TIMEOUT=15m
MAX_INFLIGHT=1
HEARTBEAT_INTERVAL=30s
MAX_DELIVER=5
RETRY_DELAY=5s
DRAIN_TIMEOUT=20s
PROCESS_DURATION=20s
LOG_LEVEL=DEBUG
