ORCHESTRATOR_IMAGE=docker.io/your-user/serverless-gpu-orchestrator:latest

NATS_SUBJECT=GPU_JOBS
ACK_WAIT=20m
MAX_DELIVER=5

LINODE_TOKEN=replace-with-your-linode-token
LINODE_TYPE=g6-nanode-1
LINODE_ROOT_PASS=replace-with-strong-root-password
GOLDEN_IMAGE_ID=private/replace-with-image-id
LINODE_MANAGED_TAG=serverless-gpu-managed
LINODE_CLUSTER_TAG=serverless-gpu-integration

MIN_NODES=0
MAX_NODES=2
MONITOR_INTERVAL=2s
COOLDOWN_DURATION=30s
SCALE_UP_THRESHOLD=1
SCALE_UP_DURATION=10s
SCALE_DOWN_IDLE_DURATION=60s
SCALE_TO_ZERO_IDLE_DURATION=180s

LOG_LEVEL=DEBUG
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_BIND_HOST=0.0.0.0
