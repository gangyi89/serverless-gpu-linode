NATS_AGENT_IMAGE=ghcr.io/your-org/serverless-gpu/nats-agent:latest
AI_PROCESSOR_IMAGE=ghcr.io/your-org/serverless-gpu/ai-processor:latest

NATS_URL=nats://control-plane-nats:4222
NATS_STREAM=GPU_JOBS
NATS_SUBJECT=GPU_JOBS
NATS_CONSUMER=gpu-workers
NATS_QUEUE_GROUP=gpu-workers
NATS_DLQ_SUBJECT=GPU_JOBS.DLQ
NATS_DLQ_STREAM=GPU_JOBS_DLQ

HTTP_TIMEOUT=15m
MAX_INFLIGHT=1
ACK_WAIT=20m
MAX_DELIVER=5
RETRY_DELAY=5s
DRAIN_TIMEOUT=20s
PROCESS_DURATION=20s
LOG_LEVEL=DEBUG
